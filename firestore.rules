rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tài khoản đã đăng nhập. KHÔNG yêu cầu email_verified của Firebase vì
    // người dùng đã xác thực bằng mã OTP 6 số gửi về email khi đăng ký,
    // nên email_verified luôn là false và sẽ chặn nhầm mọi thao tác.
    function authenticated() {
      return request.auth != null;
    }

    // Admin được xác định bằng email tài khoản quản trị, không phụ thuộc trạng thái
    // xác minh email của token (tránh việc Admin bị chặn đọc/ghi âm thầm).
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'bonbenemail@gmail.com';
    }

    /** Người đang đăng nhập có nằm trong danh sách thành viên hay không. */
    function isParticipant(members) {
      return authenticated() && members is list && request.auth.uid in members;
    }

    function isValidSupportTicket() {
      return request.resource.data.keys().hasOnly([
          'senderName', 'senderEmail', 'senderUsername', 'senderUid', 'gradeInfo', 'schoolInfo',
          'topic', 'issueContent', 'createdAt', 'handled'
        ]) &&
        request.resource.data.senderName is string &&
        request.resource.data.senderName.size() > 0 &&
        request.resource.data.senderName.size() <= 200 &&
        request.resource.data.senderUsername is string &&
        request.resource.data.senderUsername.size() <= 60 &&
        request.resource.data.senderEmail is string &&
        request.resource.data.senderEmail.matches('^[A-Za-z0-9._%+-]+@gmail\\.com$') &&
        request.resource.data.topic is string &&
        request.resource.data.topic.size() <= 200 &&
        request.resource.data.issueContent is string &&
        request.resource.data.issueContent.size() >= 5 &&
        request.resource.data.issueContent.size() <= 5000 &&
        request.resource.data.handled == false;
    }

    function canCreateOwnUser(uid) {
      return authenticated() &&
        request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.email is string &&
        request.resource.data.displayName is string &&
        request.resource.data.role in ['student', 'teacher'] &&
        request.resource.data.fullName is string &&
        request.resource.data.grade is int &&
        request.resource.data.grade >= 1 &&
        request.resource.data.grade <= 12 &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'username', 'fullName', 'displayName', 'role', 'grade', 'className',
          'school', 'schoolLevel', 'provinceOrCity', 'district', 'studentCode',
          'canPracticeAll', 'practiceApprovalStatus', 'teacherApprovalStatus',
          'teacherClassStatus', 'matchedTeacherEmail', 'matchedTeacherName',
          'phone', 'avatar', 'diamonds', 'level', 'selectedExerciseTypes',
          'createdAt'
        ]) &&
        (
          (request.resource.data.role == 'student' &&
            request.resource.data.canPracticeAll == false &&
            request.resource.data.practiceApprovalStatus == 'pending') ||
          (request.resource.data.role == 'teacher' &&
            request.resource.data.canPracticeAll == true &&
            request.resource.data.practiceApprovalStatus == 'approved' &&
            request.resource.data.teacherApprovalStatus == 'pending')
        );
    }

    // Người dùng đã đăng nhập được cập nhật hồ sơ của chính mình, nhưng không được
    // đổi uid, vai trò (role) và thời điểm tạo tài khoản.
    function canUpdateOwnUser(uid) {
      return authenticated() &&
        request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'fullName', 'displayName', 'grade', 'className', 'school',
          'schoolLevel', 'provinceOrCity', 'district', 'phone', 'avatar'
        ]);
    }

    function teacherCanUpdateStudent() {
      let teacher = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return authenticated() &&
        teacher.role == 'teacher' &&
        teacher.teacherApprovalStatus == 'approved' &&
        resource.data.role == 'student' &&
        teacher.className == resource.data.className &&
        teacher.school == resource.data.school &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'teacherClassStatus', 'matchedTeacherEmail', 'matchedTeacherName'
        ]) &&
        request.resource.data.teacherClassStatus in ['approved', 'rejected'] &&
        request.resource.data.matchedTeacherEmail == teacher.email &&
        request.resource.data.matchedTeacherName == teacher.displayName;
    }

    function teacherCanReadStudent() {
      let teacher = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return authenticated() &&
        teacher.role == 'teacher' &&
        teacher.teacherApprovalStatus == 'approved' &&
        resource.data.role == 'student' &&
        teacher.className == resource.data.className &&
        teacher.school == resource.data.school;
    }

    match /users/{uid} {
      allow get: if isAdmin() || (authenticated() && request.auth.uid == uid);
      allow list: if isAdmin() || teacherCanReadStudent();
      allow create: if isAdmin() ||
        canCreateOwnUser(uid);
      allow update: if isAdmin() || canUpdateOwnUser(uid) || teacherCanUpdateStudent();
      allow delete: if isAdmin();

      match /inbox/{notificationId} {
        allow read: if isAdmin() || (authenticated() && request.auth.uid == uid);
        allow create, delete: if isAdmin();
        allow update: if authenticated() &&
          request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']) &&
          request.resource.data.read == true;
      }
    }

    match /userProfiles/{uid} {
      allow get: if isAdmin() || (authenticated() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      match /inbox/{notificationId} {
        allow read: if isAdmin() || (authenticated() && request.auth.uid == uid);
        allow create, delete: if isAdmin();
        allow update: if authenticated() &&
          request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']) &&
          request.resource.data.read == true;
      }
    }

    // Hộp thư hỗ trợ dùng chung: người dùng gửi (kể cả khách) có thể tạo thư,
    // chỉ Admin đọc/quản lý để đồng bộ trên mọi thiết bị.
    match /supportTickets/{ticketId} {
      allow create: if isValidSupportTicket();
      allow get, list, update, delete: if isAdmin();
    }

    // Bảng ánh xạ tên tài khoản -> tài khoản, phục vụ đăng nhập bằng username.
    // Cho phép tra cứu công khai (get) vì người dùng cần tra trước khi xác thực.
    // Mỗi username là 1 document id duy nhất nên tự động chống trùng.
    match /usernames/{username} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.username is string &&
        request.resource.data.uid is string &&
        request.resource.data.email is string &&
        ((authenticated() && request.resource.data.uid == request.auth.uid) || isAdmin());
      allow update: if isAdmin() ||
        (authenticated() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() ||
        (authenticated() && resource.data.uid == request.auth.uid);
    }

    // Bảng ánh xạ email -> { uid, username } để tìm bạn bằng email.
    // Cho phép tra cứu công khai theo đúng email (document id) mà không lộ danh sách toàn bộ.
    match /emailDirectory/{emailKey} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if authenticated() &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() ||
        (authenticated() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() ||
        (authenticated() && resource.data.uid == request.auth.uid);
    }

    // Lời mời kết bạn: document id là khóa ghép cặp của 2 uid.
    match /friendRequests/{requestId} {
      allow get: if isAdmin() || isParticipant(resource.data.members);
      allow list: if isAdmin() || authenticated();
      allow create: if isParticipant(request.resource.data.members);
      allow update, delete: if isAdmin() || isParticipant(resource.data.members);
    }

    // Quan hệ bạn bè: chỉ 2 thành viên đọc/ghi, Admin đọc toàn bộ.
    match /friendships/{friendshipId} {
      allow get: if isAdmin() || isParticipant(resource.data.members);
      allow list: if isAdmin() || authenticated();
      allow create: if isParticipant(request.resource.data.members);
      allow update, delete: if isAdmin() || isParticipant(resource.data.members);
    }

    // Hội thoại 1-1 và tin nhắn: thành viên được đọc/ghi, Admin đọc toàn bộ
    // để kiểm soát lịch sử trò chuyện của người dùng.
    match /conversations/{conversationId} {
      allow get: if isAdmin() || isParticipant(resource.data.members);
      allow list: if isAdmin() || authenticated();
      allow create: if isParticipant(request.resource.data.members);
      allow update, delete: if isAdmin() || isParticipant(resource.data.members);

      match /messages/{messageId} {
        allow get, list: if isAdmin() ||
          isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.members);
        allow create: if authenticated() &&
          request.resource.data.senderUid == request.auth.uid &&
          isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.members);
        allow update, delete: if isAdmin();
      }
    }

    // Quan hệ chặn giữa 2 người dùng: chỉ 2 thành viên đọc/ghi, Admin đọc toàn bộ.
    match /blocks/{blockId} {
      allow get: if isAdmin() || isParticipant(resource.data.members);
      allow list: if isAdmin() || authenticated();
      allow create: if isParticipant(request.resource.data.members) &&
        request.resource.data.blockerUid == request.auth.uid;
      allow update, delete: if isAdmin() || isParticipant(resource.data.members);
    }
  }
}
