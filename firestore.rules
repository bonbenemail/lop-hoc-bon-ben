rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Admin được xác định bằng email tài khoản quản trị, không phụ thuộc trạng thái
    // xác minh email của token (tránh việc Admin bị chặn đọc/ghi âm thầm).
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'bonbenemail@gmail.com';
    }

    function isValidSupportTicket() {
      return request.resource.data.keys().hasOnly([
          'senderName', 'senderEmail', 'senderUid', 'gradeInfo', 'schoolInfo',
          'topic', 'issueContent', 'createdAt', 'handled'
        ]) &&
        request.resource.data.senderName is string &&
        request.resource.data.senderName.size() > 0 &&
        request.resource.data.senderName.size() <= 200 &&
        request.resource.data.senderEmail is string &&
        request.resource.data.senderEmail.matches('^[A-Za-z0-9._%+-]+@gmail\\.com$') &&
        request.resource.data.topic is string &&
        request.resource.data.topic.size() <= 200 &&
        request.resource.data.issueContent is string &&
        request.resource.data.issueContent.size() >= 5 &&
        request.resource.data.issueContent.size() <= 5000 &&
        request.resource.data.handled == false;
    }

    function canCreateOwnUser(uid) {
      return request.auth != null &&
        request.auth.uid == uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.uid == uid &&
        request.resource.data.displayName is string &&
        request.resource.data.role in ['student', 'teacher'] &&
        request.resource.data.fullName is string &&
        request.resource.data.grade is int &&
        request.resource.data.grade >= 1 &&
        request.resource.data.grade <= 12 &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'username', 'fullName', 'displayName', 'role', 'grade', 'className',
          'school', 'schoolLevel', 'provinceOrCity', 'district', 'studentCode',
          'canPracticeAll', 'practiceApprovalStatus', 'teacherApprovalStatus',
          'teacherClassStatus', 'matchedTeacherEmail', 'matchedTeacherName',
          'phone', 'avatar', 'diamonds', 'level', 'selectedExerciseTypes',
          'createdAt'
        ]) &&
        (
          (request.resource.data.role == 'student' &&
            request.resource.data.canPracticeAll == false &&
            request.resource.data.practiceApprovalStatus == 'pending') ||
          (request.resource.data.role == 'teacher' &&
            request.resource.data.canPracticeAll == true &&
            request.resource.data.practiceApprovalStatus == 'approved' &&
            request.resource.data.teacherApprovalStatus == 'pending')
        );
    }

    function canUpdateOwnUser(uid) {
      return signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'fullName', 'displayName', 'grade', 'className', 'school',
          'schoolLevel', 'provinceOrCity', 'district', 'phone', 'avatar'
        ]);
    }

    function teacherCanUpdateStudent() {
      let teacher = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return signedIn() &&
        teacher.role == 'teacher' &&
        teacher.teacherApprovalStatus == 'approved' &&
        resource.data.role == 'student' &&
        teacher.className == resource.data.className &&
        teacher.school == resource.data.school &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'teacherClassStatus', 'matchedTeacherEmail', 'matchedTeacherName'
        ]) &&
        request.resource.data.teacherClassStatus in ['approved', 'rejected'] &&
        request.resource.data.matchedTeacherEmail == teacher.email &&
        request.resource.data.matchedTeacherName == teacher.displayName;
    }

    function teacherCanReadStudent() {
      let teacher = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return signedIn() &&
        teacher.role == 'teacher' &&
        teacher.teacherApprovalStatus == 'approved' &&
        resource.data.role == 'student' &&
        teacher.className == resource.data.className &&
        teacher.school == resource.data.school;
    }

    match /users/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin() || teacherCanReadStudent();
      allow create: if isAdmin() ||
        canCreateOwnUser(uid);
      allow update: if isAdmin() || canUpdateOwnUser(uid) || teacherCanUpdateStudent();
      allow delete: if isAdmin();

      match /inbox/{notificationId} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create, delete: if isAdmin();
        allow update: if signedIn() &&
          request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']) &&
          request.resource.data.read == true;
      }
    }

    match /userProfiles/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      match /inbox/{notificationId} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create, delete: if isAdmin();
        allow update: if signedIn() &&
          request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']) &&
          request.resource.data.read == true;
      }
    }

    // Hộp thư hỗ trợ dùng chung: người dùng gửi (kể cả khách) có thể tạo thư,
    // chỉ Admin đọc/quản lý để đồng bộ trên mọi thiết bị.
    match /supportTickets/{ticketId} {
      allow create: if isValidSupportTicket();
      allow get, list, update, delete: if isAdmin();
    }

    // Bảng ánh xạ tên tài khoản -> tài khoản, phục vụ đăng nhập bằng username.
    // Cho phép tra cứu công khai (get) vì người dùng cần tra trước khi xác thực.
    // Mỗi username là 1 document id duy nhất nên tự động chống trùng.
    match /usernames/{username} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.username is string &&
        request.resource.data.uid is string &&
        request.resource.data.email is string &&
        ((request.auth != null && request.resource.data.uid == request.auth.uid) || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin() ||
        (request.auth != null && resource.data.uid == request.auth.uid);
    }
  }
}
